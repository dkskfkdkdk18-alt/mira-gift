this.opacity -= 0.005;
                if (this.opacity <= 0) {
                    this.reset();
                }
            }
        }

        function animate() {
            ctx.fillStyle = 'rgba(0, 0, 0, 0.15)'; // Эффект шлейфа
            ctx.fillRect(0, 0, width, height);
            
            particles.forEach(p => {
                p.update();
                p.draw();
            });
            
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', init);
        init();
        animate();
